# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# X (Twitter) API — https://developer.twitter.com/en/portal/dashboard
X_API_KEY=your_api_key_here
X_API_SECRET=your_api_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_SECRET=your_access_token_secret_here

# LINE Messaging API（省略可）
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_USER_ID=your_line_user_id_here

# 動作モード
AUTO_POST=false          # true にするとXへ自動投稿
GENERATE_IMAGE=false     # true にするとビジュアルカードを生成・添付

# フォントパス（オプション、省略時はシステムのNoto CJKを自動検出）
# FONT_PATH=/path/to/NotoSansCJK-Regular.ttc
# FONT_PATH_BOLD=/path/to/NotoSansCJK-Bold.ttc
