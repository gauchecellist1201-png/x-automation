# Anthropic (Claude API) - 必須
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# X (Twitter) API v2 - 自動投稿に必要（未設定の場合はLINE通知のみ）
# Developer Portal で取得: https://developer.twitter.com/en/portal/dashboard
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_SECRET=your_x_access_token_secret_here

# X Bearer Token - バズツイート分析用（省略可）
# 上記と同じアプリの Bearer Token
X_BEARER_TOKEN=your_x_bearer_token_here

# LINE Messaging API - 投稿完了通知 or 下書き送信用（省略可）
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_USER_ID=your_line_user_id_here
